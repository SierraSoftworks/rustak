{
  "$comment": "Transcribed from @tak-ps/node-tak lib/api/mission.ts `Mission` (TypeBox). CloudTAK validates every mission payload against this shape, so a field that is required here and missing from ours fails there rather than here.",
  "title": "Mission",
  "type": "object",
  "required": [
    "name",
    "description",
    "tool",
    "keywords",
    "createTime",
    "externalData",
    "feeds",
    "mapLayers",
    "inviteOnly",
    "expiration",
    "guid",
    "uids",
    "contents",
    "passwordProtected"
  ],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "chatRoom": { "type": "string" },
    "baseLayer": { "type": "string" },
    "bbox": { "type": "string" },
    "path": { "type": "string" },
    "classification": { "type": "string" },
    "tool": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "creatorUid": { "type": "string" },
    "createTime": { "type": "string" },
    "externalData": { "type": "array" },
    "feeds": { "type": "array" },
    "mapLayers": { "type": "array" },
    "ownerRole": { "$ref": "role" },
    "inviteOnly": { "type": "boolean" },
    "expiration": { "type": "number" },
    "guid": { "type": "string" },
    "uids": { "type": "array" },
    "contents": { "type": "array" },
    "passwordProtected": { "type": "boolean" },
    "token": { "type": "string" },
    "defaultRole": { "$ref": "role" },
    "missionChanges": { "type": "array" },
    "logs": { "type": "array" }
  }
}
