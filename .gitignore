target/
/config.toml
.env

# The database, and the two sidecars WAL mode keeps beside it.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.key

# Runtime data directory (server.data_dir default: certificates, content
# store, ACME cache).
data/

# The UI's build output, embedded into the server at compile time. Nothing
# here is tracked: `trunk build` wipes the directory on every run, and
# `rustak-server/build.rs` recreates it so the server still compiles without
# a UI build.
rustak-ui/dist/

# The end-to-end suite's local state. The dependencies and the browsers
# Playwright downloads are installed rather than authored, and the report and
# results are rewritten by every run.
# `e2e/package-lock.json` is deliberately *not* here: CI installs from it.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.playwright/
